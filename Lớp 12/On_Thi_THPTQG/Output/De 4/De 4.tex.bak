% ==========================================
% PHẦN I
% ==========================================
\section*{PHẦN I. CÂU TRẮC NGHIỆM NHIỀU PHƯƠNG ÁN LỰA CHỌN}
\textit{Thí sinh trả lời từ câu 1 đến câu 12. Mỗi câu hỏi thí sinh chỉ chọn một phương án. Mỗi câu trả lời đúng được 0,25 điểm.}

\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]

\item Điểm cực tiểu của đồ thị hàm số $y = x^4 - 2x^2 - 3$ có tọa độ là
\begin{enumerate}[label=\Alph*.]
    \item $(1; -4)$ và $(-1; -4)$.
    \item $(0; -3)$.
    \item $(1; 0)$.
    \item $(-1; 0)$.
\end{enumerate}

\item Tập nghiệm của bất phương trình logarit $\log_{0{,}5}(x^2 - 3x) \ge -2$ là
\begin{enumerate}[label=\Alph*.]
    \item $[-1; 4]$.
    \item $[-1; 0) \cup (3; 4]$.
    \item $(-\infty; -1] \cup [4; +\infty)$.
    \item $(0; 3)$.
\end{enumerate}

\item Biết rằng $\int_0^1 f(x) dx = 2$ và $\int_0^1 [2f(x) - 3g(x)] dx = -5$. Giá trị của tích phân $\int_0^1 g(x) dx$ bằng
\begin{enumerate}[label=\Alph*.]
    \item $3$.
    \item $-3$.
    \item $1$.
    \item $5$.
\end{enumerate}

\item Trong không gian $Oxyz$, cho hai điểm $A(2; -1; 4)$ và $B(4; 3; -2)$. Tọa độ điểm $M$ thỏa mãn $\overrightarrow{AM} = 2\overrightarrow{MB}$ là
\begin{enumerate}[label=\Alph*.]
    \item $M\left(\dfrac{10}{3}; \dfrac{5}{3}; 0\right)$.
    \item $M(3; 1; 1)$.
    \item $M\left(\dfrac{8}{3}; \dfrac{1}{3}; 2\right)$.
    \item $M(6; 5; -4)$.
\end{enumerate}

\item Cho cấp số cộng $(u_n)$ có số hạng $u_3 = 8$ và $u_7 = 20$. Số hạng đầu $u_1$ và công sai $d$ của cấp số cộng lần lượt là
\begin{enumerate}[label=\Alph*.]
    \item $u_1 = 2, d = 3$.
    \item $u_1 = 3, d = 2$.
    \item $u_1 = 2, d = 4$.
    \item $u_1 = 1, d = 3$.
\end{enumerate}

\item Khảo sát tuổi thọ (đơn vị: năm) của 40 bóng đèn LED thu được bảng mẫu số liệu ghép nhóm sau:
\begin{center}
\begin{tabular}{|c|c|c|c|c|}
\hline
\textbf{Tuổi thọ (năm)} & $[1; 3)$ & $[3; 5)$ & $[5; 7)$ & $[7; 9)$ \\ \hline
\textbf{Số bóng đèn} & $5$ & $12$ & $15$ & $8$ \\ \hline
\end{tabular}
\end{center}
Trung vị $M_e$ của mẫu số liệu ghép nhóm trên bằng
\begin{enumerate}[label=\Alph*.]
    \item $5{,}4$.
    \item $5{,}2$.
    \item $5{,}6$.
    \item $4{,}8$.
\end{enumerate}

\item Một hộp chứa 6 quả cầu màu đỏ và 4 quả cầu màu xanh có kích thước giống nhau. Lấy ngẫu nhiên đồng thời 3 quả cầu từ hộp. Xác suất để lấy được ít nhất 2 quả cầu màu đỏ bằng
\begin{enumerate}[label=\Alph*.]
    \item $\dfrac{2}{3}$.
    \item $\dfrac{1}{2}$.
    \item $\dfrac{3}{5}$.
    \item $\dfrac{5}{6}$.
\end{enumerate}

\item Cho hai biến cố $A$ và $B$ thỏa mãn $P(A) = 0{,}6$, $P(B) = 0{,}5$ và $P(A \cup B) = 0{,}8$. Giá trị xác suất có điều kiện $P(A|B)$ bằng
\begin{enumerate}[label=\Alph*.]
    \item $0{,}6$.
    \item $0{,}5$.
    \item $0{,}4$.
    \item $0{,}3$.
\end{enumerate}

\item Có bao nhiêu giá trị nguyên của tham số $m \in [-5; 5]$ để hàm số $y = \dfrac{1}{3}x^3 - mx^2 + (m^2 - 4)x + 1$ đạt cực đại tại điểm $x = 1$?
\begin{enumerate}[label=\Alph*.]
    \item $1$.
    \item $2$.
    \item $0$.
    \item $3$.
\end{enumerate}

\item Tập nghiệm của bất phương trình mũ $5^{x^2 - 3x} < 25$ là
\begin{enumerate}[label=\Alph*.]
    \item $\left(\dfrac{3 - \sqrt{17}}{2}; \dfrac{3 + \sqrt{17}}{2}\right)$.
    \item $(-\infty; -1) \cup (4; +\infty)$.
    \item $(-1; 4)$.
    \item $(0; 3)$.
\end{enumerate}

\item Trong không gian $Oxyz$, phương trình mặt cầu $(S)$ có tâm $I(1; -2; 3)$ và tiếp xúc với mặt phẳng $(P): 2x - y - 2z + 9 = 0$ là
\begin{enumerate}[label=\Alph*.]
    \item $(x - 1)^2 + (y + 2)^2 + (z - 3)^2 = \dfrac{49}{9}$.
    \item $(x + 1)^2 + (y - 2)^2 + (z + 3)^2 = \dfrac{49}{9}$.
    \item $(x - 1)^2 + (y + 2)^2 + (z - 3)^2 = \dfrac{7}{3}$.
    \item $(x - 1)^2 + (y + 2)^2 + (z - 3)^2 = 9$.
\end{enumerate}

\item Thể tích $V$ của khối tròn xoay tạo thành khi quay hình phẳng giới hạn bởi đồ thị $y = x\sqrt{1 - x^2}$ và trục hoành xung quanh trục $Ox$ bằng
\begin{enumerate}[label=\Alph*.]
    \item $V = \dfrac{2\pi}{15}$.
    \item $V = \dfrac{\pi}{15}$.
    \item $V = \dfrac{4\pi}{15}$.
    \item $V = \dfrac{2}{15}$.
\end{enumerate}

\end{enumerate}

% ==========================================
% PHẦN II
% ==========================================
\section*{PHẦN II. CÂU TRẮC NGHIỆM ĐÚNG/SAI}
\textit{Thí sinh trả lời từ câu 1 đến câu 4. Trong mỗi ý a), b), c), d) ở mỗi câu, thí sinh chọn Đúng hoặc Sai.}

\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]

\item Một xưởng may gia công sản xuất $x$ trăm bộ quần áo bảo hộ lao động mỗi tháng ($0 < x \le 50$). Chi phí sản xuất $x$ trăm bộ quần áo là $C(x) = x^3 - 12x^2 + 60x + 100$ (triệu đồng). Giá bán mỗi trăm bộ quần áo phụ thuộc vào số lượng sản xuất theo hàm giá $p(x) = 180 - 6x$ (triệu đồng/trăm bộ).
\begin{enumerate}[label=\alph*)]
    \item Tổng doanh thu thu được khi bán $x$ trăm bộ quần áo là $R(x) = 180x - 6x^2$ (triệu đồng).
    \item Hàm lợi nhuận hàng tháng của xưởng may là $L(x) = -x^3 + 6x^2 + 120x - 100$ (triệu đồng).
    \item Khi sản xuất và bán $5$ trăm bộ quần áo mỗi tháng ($x = 5$), lợi nhuận thu được bằng $525$ triệu đồng.
    \item Mức lợi nhuận hàng tháng lớn nhất mà xưởng may có thể đạt được là $700$ triệu đồng.
\end{enumerate}

\item Một ô tô điện đang di chuyển với vận tốc $v_0 = 24\text{ m/s}$ thì người lái xe phát hiện tín hiệu đèn đỏ phía trước và bắt đầu đạp phanh. Kể từ thời điểm $t = 0$ (giây), gia tốc hãm phanh biến thiên theo thời gian $a(t) = -1{,}2t\text{ (m/s}^2\text{)}$.
\begin{enumerate}[label=\alph*)]
    \item Vận tốc của xe điện tại thời điểm $t$ giây kể từ khi đạp phanh được biểu diễn bởi hàm số $v(t) = 24 - 0{,}6t^2\text{ (m/s)}$.
    \item Sau $4$ giây kể từ khi đạp phanh, vận tốc của chiếc xe điện bằng $14{,}4\text{ m/s}$.
    \item Thời gian tính từ thời điểm đạp phanh cho đến khi xe dừng hẳn xấp xỉ bằng $6{,}32$ giây.
    \item Tổng quãng đường xe điện đi được từ lúc bắt đầu đạp phanh cho đến khi dừng hẳn nhỏ hơn $100\text{ m}$.
\end{enumerate}

\item Trong một đợt tầm soát vi-rút cúm gia cầm tại vùng chăn nuôi tập trung, tỉ lệ gia cầm nhiễm vi-rút là $4\%$. Một kit thử sinh học được áp dụng có độ nhạy $95\%$ (gia cầm nhiễm vi-rút thử ra kết quả dương tính) và độ đặc hiệu $92\%$ (gia cầm không nhiễm vi-rút thử ra kết quả âm tính). Chọn ngẫu nhiên một con gia cầm trong vùng để xét nghiệm.
\begin{enumerate}[label=\alph*)]
    \item Xác suất con gia cầm được chọn không bị nhiễm vi-rút cúm gia cầm là $0{,}96$.
    \item Xác suất một con gia cầm không bị nhiễm vi-rút nhưng kit thử lại báo dương tính giả là $0{,}08$.
    \item Xác suất để một con gia cầm được chọn ngẫu nhiên có kết quả xét nghiệm dương tính bằng $0{,}1148$.
    \item Nếu con gia cầm được chọn có kết quả xét nghiệm dương tính, xác suất để con gia cầm đó thực sự bị nhiễm vi-rút lớn hơn $40\%$.
\end{enumerate}

\item Một kết cấu mái che vòm thép của sân thi đấu tennis có dạng hình chóp $S.ABCD$ đặt trong hệ tọa độ $Oxyz$ (đơn vị đo trên các trục là mét). Đỉnh vòm $S$ có tọa độ $S(4; 5; 8)$, mặt sàn nằm trên mặt phẳng $z = 0$ với 4 chân cột chân mái là $A(0; 0; 0)$, $B(8; 0; 0)$, $C(8; 10; 0)$, $D(0; 10; 0)$. Bốn thanh cáp chống chịu $SA, SB, SC, SD$ nối từ đỉnh $S$ xuống 4 chân cột.
\begin{enumerate}[label=\alph*)]
    \item Tọa độ hình chiếu vuông góc $H$ của đỉnh vòm $S$ lên mặt sàn $(ABCD)$ là $H(4; 5; 0)$.
    \item Độ dài của thanh cáp $SA$ bằng $\sqrt{105}\text{ m}$.
    \item Độ dài của cả 4 thanh cáp $SA, SB, SC, SD$ đều bằng nhau.
    \item Góc nghiêng tạo bởi thanh cáp $SA$ và mặt sàn $z = 0$ nhỏ hơn $45^\circ$.
\end{enumerate}

\end{enumerate}

% ==========================================
% PHẦN III
% ==========================================
\section*{PHẦN III. CÂU TRẮC NGHIỆM TRẢ LỜI NGẮN}
\textit{Thí sinh trả lời từ câu 1 đến câu 6. Điền đáp số theo quy chuẩn làm tròn được nêu trong từng câu.}

\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]

\item Bác Hùng muốn làm một chiếc thùng đựng rác công nghiệp bằng tôn không nắp dạng hình hộp chữ nhật có đáy là hình vuông cạnh $x\text{ (m)}$ và chiều cao $h\text{ (m)}$. Thể tích của chiếc thùng rác được ấn định bằng $0{,}108\text{ m}^3$. Bác Hùng tính toán chi phí tôn làm đáy là $150.000\text{ đồng/m}^2$ và chi phí tôn làm 4 mặt bên xung quanh là $100.000\text{ đồng/m}^2$. Tìm giá trị của $x$ (m) để tổng chi phí mua tôn làm thùng rác đạt giá trị nhỏ nhất (làm tròn kết quả đến hàng phần mười của mét).

\item Chị Mai gửi cố định mỗi tháng $10$ triệu đồng vào ngân hàng theo hình thức tiết kiệm tích lũy định kỳ với lãi suất $0{,}55\%$/tháng (lãi nhập gốc hàng tháng). Chị Mai muốn tích lũy tổng số tiền cả gốc và lãi đạt tối thiểu $500$ triệu đồng để chuẩn bị mở cửa hàng kinh doanh. Hỏi chị Mai cần gửi tiền liên tục trong ít nhất bao nhiêu tháng?

\item Một đài ra-đa kiểm soát hàng không đặt tại vị trí gốc tọa độ $O(0; 0; 0)$ trong hệ tọa độ $Oxyz$ (đơn vị trên các trục là km). Một chiếc máy bay thương mại đang trong quá trình hạ cánh chuyển động thẳng đều đi qua hai điểm mốc $A(3; 2; 4)$ và $B(7; 6; 8)$. Tìm khoảng cách ngắn nhất từ đài ra-đa $O$ đến đường bay của máy bay (làm tròn kết quả đến hàng phần mười của km).

\item Khảo sát mức thu nhập hàng tháng (đơn vị: triệu đồng) của $80$ công nhân tại một khu công nghiệp thu được bảng số liệu ghép nhóm sau:
\begin{center}
\begin{tabular}{|c|c|c|c|c|c|}
\hline
\textbf{Thu nhập (triệu đồng)} & $[6; 9)$ & $[9; 12)$ & $[12; 15)$ & $[15; 18)$ & $[18; 21)$ \\ \hline
\textbf{Số công nhân} & $12$ & $28$ & $24$ & $11$ & $5$ \\ \hline
\end{tabular}
\end{center}
Tính tứ phân vị thứ nhất $Q_1$ của mẫu số liệu ghép nhóm trên (làm tròn kết quả đến hàng phần mười).

\item Một xí nghiệp dệt may sử dụng 3 chuyền may tự động $A, B, C$ với tỉ lệ sản phẩm cung ứng ra thị trường tương ứng là $45\%$, $35\%$ và $20\%$. Tỉ lệ sản phẩm bị lỗi đường may do các chuyền $A, B, C$ tạo ra lần lượt là $1{,}5\%$, $2\%$ và $3{,}5\%$. Lấy ngẫu nhiên một sản phẩm trong kho hàng để kiểm tra. Tính xác suất để sản phẩm được chọn bị lỗi đường may (kết quả viết dưới dạng số thập phân).

\item Hai bạn Hải và Sơn cùng chơi một trò chơi bốc bóng ngẫu nhiên. Hải có một hộp gồm 9 quả bóng được đánh số từ 1 đến 9. Sơn có một hộp gồm 8 quả bóng được đánh số từ 1 đến 8. Mỗi bạn bốc ngẫu nhiên 3 quả bóng từ hộp của mình, rồi xếp các số ghi trên 3 quả bóng bốc được theo thứ tự giảm dần để tạo thành một số có 3 chữ số. Bạn nào xếp được số lớn hơn là người chiến thắng. Tính xác suất để Sơn thua (làm tròn kết quả đến hàng phần trăm dưới dạng số thập phân).

\end{enumerate}

