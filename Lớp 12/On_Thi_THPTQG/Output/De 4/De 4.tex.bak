% ==========================================
% HƯỚNG DẪN GIẢI CHI TIẾT
% ==========================================
\section*{HƯỚNG DẪN GIẢI CHI TIẾT}

\subsection*{PHẦN I}
\begin{enumerate}[label=\textbf{Câu \\arabic*:}, leftmargin=*]
\item \textbf{Đáp án A.} $y' = 4x^3 - 4x = 0 \iff x = 0$ hoặc $x = \pm 1$. Ta có $y''(1) = y''(-1) = 8 > 0 \implies$ hai điểm cực tiểu là $(1; -4)$ và $(-1; -4)$.
\item \textbf{Đáp án B.} ĐKXĐ: $x^2 - 3x > 0 \iff x < 0$ hoặc $x > 3$. BPT $\iff x^2 - 3x \le (0{,}5)^{-2} = 4 \iff x^2 - 3x - 4 \le 0 \iff -1 \le x \le 4$. Kết hợp ĐKXĐ ta có $x \in [-1; 0) \cup (3; 4]$.
\item \textbf{Đáp án A.} $2\int_0^1 f(x) dx - 3\int_0^1 g(x) dx = -5 \implies 2(2) - 3\int_0^1 g(x) dx = -5 \implies 3\int_0^1 g(x) dx = 9 \implies \int_0^1 g(x) dx = 3$.
\item \textbf{Đáp án A.} $\overrightarrow{AM} = 2\overrightarrow{MB} \implies M - A = 2(B - M) \implies 3M = A + 2B \implies M = \left(\dfrac{2 + 2(4)}{3}; \dfrac{-1 + 2(3)}{3}; \dfrac{4 + 2(-2)}{3}\right) = \left(\dfrac{10}{3}; \dfrac{5}{3}; 0\right)$.
\item \textbf{Đáp án A.} $u_7 - u_3 = 4d = 20 - 8 = 12 \implies d = 3$. $u_1 = u_3 - 2d = 8 - 6 = 2$.
\item \textbf{Đáp án A.} Tần số tích lũy: Cỡ mẫu $N = 40 \implies \dfrac{N}{2} = 20$. Nhóm 2 tích lũy $17$, nhóm 3 chứa trung vị $[5; 7)$. $M_e = 5 + \dfrac{20 - 17}{15} \times (7 - 5) = 5 + \dfrac{6}{15} = 5{,}4$.
\item \textbf{Đáp án A.} Số cách chọn 3 quả từ 10 quả là $C_{10}^3 = 120$. Số cách chọn ít nhất 2 đỏ: chọn 2 đỏ 1 xanh ($C_6^2 C_4^1 = 15 \times 4 = 60$) hoặc 3 đỏ ($C_6^3 = 20$). Tổng số cách thỏa mãn = $80 \implies P = \dfrac{80}{120} = \dfrac{2}{3}$.
\item \textbf{Đáp án A.} $P(A \cap B) = P(A) + P(B) - P(A \cup B) = 0{,}6 + 0{,}5 - 0{,}8 = 0{,}3 \implies P(A|B) = \dfrac{P(A \cap B)}{P(B)} = \dfrac{0{,}3}{0{,}5} = 0{,}6$.
\item \textbf{Đáp án A.} $y' = x^2 - 2mx + m^2 - 4 = (x - m - 2)(x - m + 2)$. Điểm cực đại là $x = m - 2$. Để cực đại tại $x = 1 \implies m - 2 = 1 \iff m = 3$. Thử lại $y''(1) = 2(1) - 2(3) = -4 < 0$ (thỏa mãn). Vậy có 1 giá trị $m = 3$.
\item \textbf{Đáp án A.} $5^{x^2 - 3x} < 5^2 \iff x^2 - 3x - 2 < 0 \iff \dfrac{3 - \sqrt{17}}{2} < x < \dfrac{3 + \sqrt{17}}{2}$.
\item \textbf{Đáp án A.} Bán kính $R = d(I, P) = \dfrac{|2(1) - (-2) - 2(3) + 9|}{\sqrt{2^2 + (-1)^2 + (-2)^2}} = \dfrac{7}{3} \implies R^2 = \dfrac{49}{9}$. Phương trình mặt cầu $(x - 1)^2 + (y + 2)^2 + (z - 3)^2 = \dfrac{49}{9}$.
\item \textbf{Đáp án A.} $V = \pi \int_0^1 \left(x\sqrt{1 - x^2}\right)^2 dx = \pi \int_0^1 x^2(1 - x^2) dx = \pi \left[\dfrac{x^3}{3} - \dfrac{x^5}{5}\right]_0^1 = \dfrac{2\pi}{15}$.
\end{enumerate}

\subsection*{PHẦN II}
\begin{enumerate}[label=\textbf{Câu \\arabic*:}, leftmargin=*]
\item \textbf{Câu 1 (Kinh tế xưởng may):}
\begin{itemize}
    \item a) \textbf{Đúng}: Doanh thu $R(x) = x \cdot p(x) = x(180 - 6x) = 180x - 6x^2$.
    \item b) \textbf{Đúng}: Lợi nhuận $L(x) = R(x) - C(x) = -x^3 + 6x^2 + 120x - 100$.
    \item c) \textbf{Đúng}: $L(5) = -5^3 + 6(5^2) + 120(5) - 100 = -125 + 150 + 600 - 100 = 525$ triệu đồng.
    \item d) \textbf{Sai}: $L'(x) = -3x^2 + 12x + 120 = 0 \iff x = 2 + 2\sqrt{11} \approx 8{,}63$. Với $x = 8{,}63$, $\max L \approx 738{,}1$ triệu đồng (không phải $700$).
\end{itemize}

\item \textbf{Câu 2 (Vật lý chuyển động ô tô điện):}
\begin{itemize}
    \item a) \textbf{Đúng}: $v(t) = 24 + \int (-1{,}2t) dt = 24 - 0{,}6t^2$.
    \item b) \textbf{Đúng}: $v(4) = 24 - 0{,}6(16) = 14{,}4\text{ m/s}$.
    \item c) \textbf{Đúng}: Xe dừng khi $v(t) = 0 \iff 0{,}6t^2 = 24 \iff t = 2\sqrt{10} \approx 6{,}32\text{ s}$.
    \item d) \textbf{Sai}: Quãng đường $S = \int_0^{2\sqrt{10}} (24 - 0{,}6t^2) dt = 32\sqrt{10} \approx 101{,}19\text{ m} > 100\text{ m}$.
\end{itemize}

\item \textbf{Câu 3 (Chẩn đoán vi-rút cúm gia cầm):}
\begin{itemize}
    \item a) \textbf{Đúng}: $P(\overline{N}) = 1 - 0{,}04 = 0{,}96$.
    \item b) \textbf{Đúng}: Độ đặc hiệu $92\% \implies$ tỷ lệ báo dương tính giả $P(D|\overline{N}) = 1 - 0{,}92 = 0{,}08$.
    \item c) \textbf{Đúng}: $P(D) = P(N)P(D|N) + P(\overline{N})P(D|\overline{N}) = 0{,}04 \times 0{,}95 + 0{,}96 \times 0{,}08 = 0{,}1148$.
    \item d) \textbf{Sai}: Áp dụng công thức Bayes, $P(N|D) = \dfrac{0{,}04 \times 0{,}95}{0{,}1148} = \dfrac{0{,}038}{0{,}1148} \approx 33{,}1\% < 40\%$.
\end{itemize}

\item \textbf{Câu 4 (Oxyz Vòm mái che sân tennis):}
\begin{itemize}
    \item a) \textbf{Đúng}: Hình chiếu của $S(4; 5; 8)$ lên $z = 0$ là $H(4; 5; 0)$.
    \item b) \textbf{Đúng}: $SA = \sqrt{4^2 + 5^2 + 8^2} = \sqrt{105}\text{ m}$.
    \item c) \textbf{Đúng}: Tương tự $SB = SC = SD = \sqrt{(-4)^2 + (-5)^2 + 8^2} = \sqrt{105}\text{ m}$.
    \item d) \textbf{Sai}: $\sin\alpha = \dfrac{8}{\sqrt{105}} \approx 0{,}7807 \implies \alpha \approx 51{,}32^\circ > 45^\circ$.
\end{itemize}

\end{enumerate}

\subsection*{PHẦN III}
\begin{enumerate}[label=\textbf{Câu \\arabic*:}, leftmargin=*]
\item \textbf{Đáp số: 0,5.} Thể tích $V = x^2 h = 0{,}108 \implies h = \dfrac{0{,}108}{x^2}$. Tổng chi phí $C(x) = 150000x^2 + 100000(4xh) = 150000x^2 + \dfrac{43200}{x}$. $C'(x) = 300000x - \dfrac{43200}{x^2} = 0 \iff 300000x^3 = 43200 \iff x^3 = 0{,}144 \iff x = \sqrt[3]{0{,}144} \approx 0{,}524 \approx 0{,}5\text{ m}$.
\item \textbf{Đáp số: 45.} $10 \times \dfrac{1{,}0055}{0{,}0055} \left[(1{,}0055)^n - 1\right] \ge 500 \iff (1{,}0055)^n \ge 1{,}2735 \iff n \ge \dfrac{\ln(1{,}2735)}{\ln(1{,}0055)} \approx 44{,}07 \implies n = 45$ tháng.
\item \textbf{Đáp số: 1,4.} Vectơ chỉ phương $\vec{u} = (1; 1; 1)$, $\overrightarrow{OA} = (3; 2; 4) \implies [\overrightarrow{OA}, \vec{u}] = (-2; 1; 1) \implies d(O, AB) = \dfrac{\sqrt{(-2)^2 + 1^2 + 1^2}}{\sqrt{1^2 + 1^2 + 1^2}} = \dfrac{\sqrt{6}}{\sqrt{3}} = \sqrt{2} \approx 1{,}4\text{ km}$.
\item \textbf{Đáp số: 9,9.} Cỡ mẫu $N = 80 \implies \dfrac{N}{4} = 20$. Tần số tích lũy nhóm 1 là 12, nhóm 2 tích lũy 40 $\implies Q_1$ thuộc $[9; 12)$. $Q_1 = 9 + \dfrac{20 - 12}{28} \times (12 - 9) = 9 + \dfrac{6}{7} \approx 9{,}857 \approx 9{,}9$.
\item \textbf{Đáp số: 0,02075.} $P(L) = 0{,}45 \times 0{,}015 + 0{,}35 \times 0{,}02 + 0{,}20 \times 0{,}035 = 0{,}00675 + 0{,}00700 + 0{,}00700 = 0{,}02075$.
\item \textbf{Đáp số: 0,66.} (Trích từ Ngân hàng VDC): Không gian mẫu $|\Omega| = C_9^3 \times C_8^3 = 84 \times 56 = 4704$. Số trường hợp Hòa (Hải và Sơn chọn cùng bộ 3 số từ $\{1..8\}$) là $C_8^3 = 56$. Số trường hợp Hải thắng khi cả hai chọn bóng từ $\{1..8\}$ là $\dfrac{56 \times 56 - 56}{2} = 1540$. Số trường hợp Hải bốc chứa quả số 9 (luôn thắng) là $C_8^2 \times C_8^3 = 28 \times 56 = 1568$. Tổng số trường hợp Hải thắng (Sơn thua) là $1540 + 1568 = 3108$. Xác suất Sơn thua $P = \dfrac{3108}{4704} = \dfrac{37}{56} \approx 0{,}6607 \approx 0{,}66$.
\end{enumerate}

