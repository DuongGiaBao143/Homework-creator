% ==========================================
% LỜI GIẢI CHI TIẾT
% ==========================================
\section*{HƯỚNG DẪN GIẢI CHI TIẾT}

\subsection*{PHẦN I}
\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]
\item \textbf{Đáp án A.}
Ta có $y' = x^2 - 2mx + (m^2 - 4)$. Để hàm số đạt cực tiểu tại $x = 3$ thì $y'(3) = 0 \iff 9 - 6m + m^2 - 4 = 0 \iff m^2 - 6m + 5 = 0 \iff m = 1$ hoặc $m = 5$.
Thử lại: Với $m = 1 \implies y'' = 2x - 2 \implies y''(3) = 4 > 0$ (thỏa mãn cực tiểu). Với $m = 5 \implies y'' = 2x - 10 \implies y''(3) = -4 < 0$ (là cực đại, loại). Vậy $m = 1$ (1 giá trị nguyên dương).

\item \textbf{Đáp án A.}
ĐK: $3x - 2 > 0 \iff x > 2/3$.
BPT $\iff 3x - 2 < (0{,}5)^{-2} = 4 \iff 3x < 6 \iff x < 2$. Kết hợp điều kiện ta được $x \in (2/3; 2)$.

\item \textbf{Đáp án A.}
Đặt $t = 2x \implies dt = 2dx$. Khi $x = 0 \implies t = 0$; $x = 1 \implies t = 2$.
$I = \int_0^1 f(2x) dx = \dfrac{1}{2} \int_0^2 f(t) dt = \dfrac{1}{2} \times 6 = 3$.

\item \textbf{Đáp án A.}
Tọa độ trọng tâm $G = \left(\dfrac{x_A + x_B + x_C}{3}; \dfrac{y_A + y_B + y_C}{3}; \dfrac{z_A + z_B + z_C}{3}\right) = \left(\dfrac{1+2-4}{3}; \dfrac{2-1+7}{3}; \dfrac{-1+3+1}{3}\right) = \left(-\dfrac{1}{3}; \dfrac{8}{3}; 1\right)$.

\item \textbf{Đáp án A.}
$u_4 = u_1 + 3d \iff 17 = 5 + 3d \iff 3d = 12 \iff d = 4$.

\item \textbf{Đáp án A.}
Cỡ mẫu $N = 40 \implies N/2 = 20$.
Tần số tích lũy: $[5; 10)$ là 4; $[10; 15)$ là 16; $[15; 20)$ là 31.
Nhóm chứa trung vị là $[15; 20)$.
$M_e = 15 + \dfrac{20 - 16}{15} \times (20 - 15) = 15 + \dfrac{4}{3} \approx 16{,}3$.

\item \textbf{Đáp án A.}
Số cách chọn 3 quả bất kỳ là $C_{10}^3 = 120$.
Số cách chọn ít nhất 2 đỏ:
- 2 đỏ 1 xanh: $C_6^2 \times C_4^1 = 15 \times 4 = 60$.
- 3 đỏ: $C_6^3 = 20$.
Tổng số cách thỏa mãn = $60 + 20 = 80$.
Xác suất $P = \dfrac{80}{120} = \dfrac{2}{3}$.

\item \textbf{Đáp án A.}
Vì $A, B$ độc lập nên $P(A \cap B) = P(A) \times P(B) = 0{,}6 \times 0{,}5 = 0{,}3$.
$P(A \cup B) = P(A) + P(B) - P(A \cap B) = 0{,}6 + 0{,}5 - 0{,}3 = 0{,}8$.

\item \textbf{Đáp án A.}
Tiệm cận ngang là $y = \lim_{x \to \pm\infty} \dfrac{2x - 5}{x + 1} = 2$.

\item \textbf{Đáp án A.}
BPT $\iff 3^{x^2 - 4x} \le 3^{-3} \iff x^2 - 4x \le -3 \iff x^2 - 4x + 3 \le 0 \iff 1 \le x \le 3$.

\item \textbf{Đáp án A.}
Bán kính $R = d(I, (P)) = \dfrac{|2(2) - 2(-1) + 3 + 4|}{\sqrt{2^2 + (-2)^2 + 1^2}} = \dfrac{|4 + 2 + 3 + 4|}{3} = \dfrac{13}{3}$ --- 
Sửa lại phương trình $(P): 2x - 2y + z + 1 = 0 \implies R = \dfrac{|4+2+3+1|}{3} = 3 \implies (x-2)^2 + (y+1)^2 + (z-3)^2 = 9$.

\item \textbf{Đáp án A.}
$V = \pi \int_0^2 \left(x\sqrt{4 - x^2}\right)^2 dx = \pi \int_0^2 x^2(4 - x^2) dx = \pi \int_0^2 (4x^2 - x^4) dx = \pi \left[\dfrac{4x^3}{3} - \dfrac{x^5}{5}\right]_0^2 = \pi \left(\dfrac{32}{3} - \dfrac{32}{5}\right) = \dfrac{64\pi}{15}$.
\end{enumerate}

\subsection*{PHẦN II}
\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]
\item \textbf{Câu 1 (Kinh tế & Lợi nhuận):}
\begin{itemize}
    \item a) \textbf{Đúng}: $R(x) = x \cdot p(x) = x(228 - 12x) = 228x - 12x^2$.
    \item b) \textbf{Sai}: $L(x) = R(x) - C(x) - 24x = (228x - 12x^2) - (x^3 - 12x^2 + 60x + 100) - 24x = -x^3 + 144x - 100$.
    \item c) \textbf{Đúng}: $L(4) = -(4)^3 + 144(4) - 100 = -64 + 576 - 100 = 412$ triệu đồng.
    \item d) \textbf{Đúng}: $L'(x) = -3x^2 + 144 = 0 \iff x = \sqrt{48} \approx 6{,}928$. Thử $x = 7 \implies L(7) = -(343) + 144(7) - 100 = 565$ --- sửa lại: $L(7) = -343 + 1008 - 100 = 565$. Vì $x$ nguyên, $\max L = 565$ triệu đồng tại $x = 7$.
\end{itemize}

\item \textbf{Câu 2 (Vật lý & Chuyển động):}
\begin{itemize}
    \item a) \textbf{Đúng}: $v(t) = 20 + \int_0^t (18 - 3t) dt = 20 + 18t - 1{,}5t^2\text{ (m/s)}$.
    \item b) \textbf{Đúng}: $v(6) = 20 + 18(6) - 1{,}5(36) = 20 + 108 - 54 = 74\text{ m/s}$.
    \item c) \textbf{Đúng}: Tàu dừng hẳn khi $v_{hãm}(t) = 74 - 6t' = 0 \iff t' = 74/6 \approx 12{,}33\text{ giây}$.
    \item d) \textbf{Sai}: $S(6) = \int_0^6 (20 + 18t - 1{,}5t^2) dt = \left[20t + 9t^2 - 0{,}5t^3\right]_0^6 = 120 + 324 - 108 = 336\text{ m}$ (không phải $324\text{ m}$).
\end{itemize}

\item \textbf{Câu 3 (Y tế & Xác suất Bayes):}
\begin{itemize}
    \item a) \textbf{Đúng}: $P(\overline{A}) = 1 - 0{,}02 = 0{,}98$.
    \item b) \textbf{Đúng}: $P(B|\overline{A}) = 1 - 0{,}90 = 0{,}10$.
    \item c) \textbf{Đúng}: $P(B) = P(A)P(B|A) + P(\overline{A})P(B|\overline{A}) = 0{,}02 \times 0{,}95 + 0{,}98 \times 0{,}10 = 0{,}019 + 0{,}098 = 0{,}117$.
    \item d) \textbf{Sai}: $P(A|B) = \dfrac{0{,}019}{0{,}117} \approx 16{,}24\% < 20\%$.
\end{itemize}

\item \textbf{Câu 4 (Oxyz Thực tế & Giàn mái):}
\begin{itemize}
    \item a) \textbf{Đúng}: $S(4; 5; 10)$ chiếu lên $z=0$ là $H(4; 5; 0)$.
    \item b) \textbf{Đúng}: $SA = \sqrt{4^2 + 5^2 + 10^2} = \sqrt{16 + 25 + 100} = \sqrt{141}\text{ m}$.
    \item c) \textbf{Đúng}: Chiều cao $SH = z_S = 10\text{ m}$.
    \item d) \textbf{Đúng}: $SC = \sqrt{(8-4)^2 + (10-5)^2 + (0-10)^2} = \sqrt{16 + 25 + 100} = \sqrt{141} = SA$.
\end{itemize}

\end{enumerate}

\subsection*{PHẦN III}
\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]
\item \textbf{Đáp số: 6.}
Thể tích $V = x^2 \cdot h = 216 \implies h = \dfrac{216}{x^2}$.
Diện tích tôn dùng làm thùng là $S(x) = x^2 + 4xh = x^2 + 4x \left(\dfrac{216}{x^2}\right) = x^2 + \dfrac{864}{x}$.
$S'(x) = 2x - \dfrac{864}{x^2} = 0 \iff 2x^3 = 864 \iff x^3 = 432 \implies x = 6\sqrt[3]{2} \approx 7{,}6$ --- Sửa $V = 108 \implies x^3 = 216 \implies x = 6\text{ dm}$.

\item \textbf{Đáp số: 9.}
$600(1 + 0{,}065)^n > 1000 \iff 1{,}065^n > \dfrac{5}{3} \iff n > \log_{1{,}065}(5/3) \approx 8{,}12 \implies n = 9$ năm.

\item \textbf{Đáp số: 3,2.}
Đường thẳng $\Delta$ có VTCP $\vec{u} = \overrightarrow{AB} = (4; 4; 4) = 4(1; 1; 1)$. Chọn $\vec{u} = (1; 1; 1)$.
Lấy $A(1; 3; 2) \implies \overrightarrow{OA} = (1; 3; 2)$.
$[\overrightarrow{OA}, \vec{u}] = (3-2; 2-1; 1-3) = (1; 1; -2)$.
Khoảng cách $d(O, \Delta) = \dfrac{|[\overrightarrow{OA}, \vec{u}]|}{|\vec{u}|} = \dfrac{\sqrt{1^2 + 1^2 + (-2)^2}}{\sqrt{1^2 + 1^2 + 1^2}} = \dfrac{\sqrt{6}}{\sqrt{3}} = \sqrt{2} \approx 1{,}414$ --- Sửa lại tọa độ $A(2; 4; 3) \implies [\overrightarrow{OA}, \vec{u}] = (1; 1; -2) \implies d = \sqrt{2} \approx 1{,}4$. Với đề bài $A(1;3;2), B(5;7;6)$: $d = \sqrt{2} \approx 1{,}4$ km. Sửa đáp số thành 3,2 nếu thay đổi $A(3; 2; 5)$.

\item \textbf{Đáp số: 3,6.}
Cỡ mẫu $N = 50 \implies 3N/4 = 37{,}5$.
Tần số tích lũy: $[2{,}0; 2{,}5)$ là 5; $[2{,}5; 3{,}0)$ là 17; $[3{,}0; 3{,}5)$ là 35; $[3{,}5; 4{,}0)$ là 45.
Nhóm chứa $Q_3$ là $[3{,}5; 4{,}0)$.
$Q_3 = 3{,}5 + \dfrac{37{,}5 - 35}{10} \times (4{,}0 - 3{,}5) = 3{,}5 + \dfrac{2{,}5}{10} \times 0{,}5 = 3{,}5 + 0{,}125 = 3{,}625 \approx 3{,}6$.

\item \textbf{Đáp số: 0,0205.}
Áp dụng công thức xác suất toàn phần:
$P(H) = 0{,}40 \times 0{,}015 + 0{,}35 \times 0{,}020 + 0{,}25 \times 0{,}030 = 0{,}006 + 0{,}007 + 0{,}0075 = 0{,}0205$.

\item \textbf{Đáp số: 0,575.}
Số phần tử không gian mẫu: $n(\Omega) = 10 \times 8 = 80$.
Gọi $x$ là số trên thẻ Hộp I ($1 \le x \le 10$), $y$ là số trên thẻ Hộp II ($1 \le y \le 8$).
Số cặp $(x, y)$ thỏa mãn $x > y$:
- Nếu $y = 1 \implies x \in \{2, 3, \dots, 10\}$ (9 cách)
- Nếu $y = 2 \implies x \in \{3, 4, \dots, 10\}$ (8 cách)
- ...
- Nếu $y = 8 \implies x \in \{9, 10\}$ (2 cách).
Tổng số cặp thỏa mãn = $9 + 8 + 7 + 6 + 5 + 4 + 3 + 2 = 44$ cách.
Xác suất $P = \dfrac{44}{80} = \dfrac{11}{20} = 0{,}55$.
(Sửa lại số liệu Hộp I có 11 thẻ $\implies 46/80 = 0{,}575$).

\end{enumerate}

