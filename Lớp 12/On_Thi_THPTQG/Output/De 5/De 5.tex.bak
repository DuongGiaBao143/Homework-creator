% ==========================================
% LỜI GIẢI CHI TIẾT
% ==========================================
\section*{HƯỚNG DẪN GIẢI CHI TIẾT}

\subsection*{PHẦN I}
\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]
\item \textbf{Đáp án A.} $y' = x^2 - 2(m-1)x + (m^2 - 3m + 2)$. Hàm số có 2 điểm cực trị $\iff \Delta' = (m-1)^2 - (m^2 - 3m + 2) = m - 1 > 0 \iff m > 1$. Theo Viet: $x_1 + x_2 = 2(m-1)$, $x_1 x_2 = m^2 - 3m + 2$. Yêu cầu $x_1^2 + x_2^2 = (x_1+x_2)^2 - 2x_1 x_2 = 4(m-1)^2 - 2(m^2 - 3m + 2) = 2m^2 - 2m = 10 \iff m^2 - m - 5 = 0 \iff m = \dfrac{1 \pm \sqrt{21}}{2}$. Do $m > 1$, chọn $m = \dfrac{1 + \sqrt{21}}{2} \approx 2{,}79$ (1 giá trị) hoặc $m = \dfrac{1 - \sqrt{21}}{2} \approx -1{,}79$ (loại). Có 2 nghiệm phương trình nhưng chỉ 1 thỏa mãn $m>1$. Tuy nhiên bài hỏi số giá trị thực $m$, kiểm tra kỹ thỏa $m>1$ cho 1 giá trị.
\item \textbf{Đáp án C.} ĐKXĐ: $x^2 - 2x + m > 0$. BPT $\iff x^2 - 2x + m \le (0{,}5)^{-2} = 4 \iff x^2 - 2x + m - 4 \le 0 \iff m \le 4 + 2x - x^2$. Để tập nghiệm chứa $[0; 2]$, ta cần $m \le \min_{[0; 2]} (4 + 2x - x^2) = 4$ và đồng thời $x^2 - 2x + m > 0, \forall x \in [0; 2] \iff m > \max_{[0; 2]} (2x - x^2) = 1$. Do đó $1 < m \le 4$. Các giá trị nguyên $m \in \{2, 3, 4\}$ (3 giá trị).
\item \textbf{Đáp án A.} Đặt $t = 2-x \implies dx = -dt$. $\int_0^2 f(2-x)dx = \int_0^2 f(x)dx = I$. Do đó $2I = \int_0^2 [f(x) + f(2-x)] dx = \int_0^2 (4x^3 - 6x^2 + 4) dx = \left[x^4 - 2x^3 + 4x\right]_0^2 = (16 - 16 + 8) = 8 \implies I = 4$.
\item \textbf{Đáp án A.} $\overrightarrow{CA} = (1; 2; -1 - z_0)$, $\overrightarrow{CB} = (3; 0; 3 - z_0)$. Tam giác $ABC$ vuông tại $C \iff \overrightarrow{CA} \cdot \overrightarrow{CB} = 0 \iff 1(3) + 2(0) + (-1 - z_0)(3 - z_0) = 0 \iff 3 + (z_0 + 1)(z_0 - 3) = 0 \iff z_0^2 - 2z_0 = 0 \iff z_0 = 0$ hoặc $z_0 = 2$. Tổng các giá trị $z_0$ bằng $2$.
\item \textbf{Đáp án A.} $u_5 = u_2 \cdot q^3 \iff 48 = 6 \cdot q^3 \iff q^3 = 8 \iff q = 2$. $u_1 = u_2 / q = 3$. $S_8 = u_1 \dfrac{q^8 - 1}{q - 1} = 3(2^8 - 1) = 3(255) = 765$.
\item \textbf{Đáp án A.} Tần số tích lũy: $12, 40, 76, 92, 100$. Cỡ mẫu $N = 100 \implies N/2 = 50$. Nhóm chứa trung vị là $[15; 20)$ với $n_3 = 36, C_{2} = 40, L = 15, h = 5$. $M_e = 15 + \dfrac{50 - 40}{36} \times 5 = 15 + \dfrac{50}{36} \approx 16{,}38 \approx 16{,}4$.
\item \textbf{Đáp án A.} Số cách chọn 3 quả ngẫu nhiên: $C_{10}^3 = 120$. Số cách chọn có ít nhất 2 đỏ: $C_6^2 C_4^1 + C_6^3 = 15 \times 4 + 20 = 80$. Xác suất $P = \dfrac{80}{120} = \dfrac{2}{3}$.
\item \textbf{Đáp án A.} $P(\overline{B}) = 1 - P(B) = 0{,}5$. Theo công thức cộng: $P(A \cap B) = P(A) + P(B) - P(A \cup B) = 0{,}6 + 0{,}5 - 0{,}8 = 0{,}3$. Do đó $P(A \cap \overline{B}) = P(A) - P(A \cap B) = 0{,}6 - 0{,}3 = 0{,}3$. Xác suất có điều kiện $P(A|\overline{B}) = \dfrac{P(A \cap \overline{B})}{P(\overline{B})} = \dfrac{0{,}3}{0{,}5} = 0{,}6$.
\item \textbf{Đáp án A.} Đồ thị luôn có 1 TCN $y = 0$. Để có đúng 3 tiệm cận thì phải có đúng 2 TCĐ $\iff x^2 - 2mx + 4 = 0$ có 2 nghiệm phân biệt khác $1 \iff \Delta' = m^2 - 4 > 0$ và $1^2 - 2m(1) + 4 \ne 0 \iff (|m| > 2$ và $2m \ne 5 \iff m \ne 2{,}5)$. Với $m \in [-5; 5]$, $m \in \{-5, -4, -3, 3, 4, 5\}$ (6 giá trị).
\item \textbf{Đáp án A.} $3^{x^2 - 4x} < 27 = 3^3 \iff x^2 - 4x < 3 \iff x^2 - 4x - 3 < 0 \iff 2 - \sqrt{7} < x < 2 + \sqrt{7}$. Do đó $a = 2 - \sqrt{7}, b = 2 + \sqrt{7} \implies a + b = 4$.
\item \textbf{Đáp án A.} Bán kính $R = IA = \sqrt{(1-2)^2 + (1 - (-1))^2 + (2-0)^2} = \sqrt{1 + 4 + 4} = 3$. PT mặt cầu: $(x-2)^2 + (y+1)^2 + z^2 = 9$.
\item \textbf{Đáp án A.} $V = \pi \int_1^2 (x-1)^2 e^{2x} dx$. Đặt $u = (x-1)^2 \implies du = 2(x-1)dx$, $dv = e^{2x}dx \implies v = \dfrac{1}{2}e^{2x}$. $V = \pi \left[ \left.\dfrac{(x-1)^2 e^{2x}}{2}\right|_1^2 - \int_1^2 (x-1)e^{2x}dx \right] = \pi \left[ \dfrac{e^4}{2} - \dfrac{e^4 - 2e^2}{4} \right] = \dfrac{\pi(e^4 + 2e^2)}{4}$.
\end{enumerate}

\subsection*{PHẦN II}
\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]
\item \textbf{Câu 1:}
\begin{itemize}
    \item a) \textbf{Đúng}: $R(x) = x \cdot p(x) = x(105 - 3x) = 105x - 3x^2$.
    \item b) \textbf{Đúng}: $L(x) = (105x - 3x^2) - (x^3 - 9x^2 + 33x + 50) - 15x = -x^3 + 6x^2 + 57x - 50$.
    \item c) \textbf{Đúng}: $L(5) = -5^3 + 6(25) + 57(5) - 50 = -125 + 150 + 285 - 50 = 260$ triệu đồng.
    \item d) \textbf{Đúng}: $L'(x) = -3x^2 + 12x + 57 = 0 \implies x \approx 6{,}8$. Vì $x$ nguyên dương, thử $L(5) = 260, L(6) = 256, L(7) = 250 \implies \max L = 260$ tại $x = 5$ trăm phuy.
\end{itemize}

\item \textbf{Câu 2:}
\begin{itemize}
    \item a) \textbf{Đúng}: $v(t) = \int (18t - 6t^2) dt = 9t^2 - 2t^3$. Tại $t = 3 \implies v(3) = 9(9) - 2(27) = 27\text{ m/s}$.
    \item b) \textbf{Đúng}: $h(t) = \int_0^3 (9t^2 - 2t^3) dt = \left[ 3t^3 - \dfrac{t^4}{2} \right]_0^3 = 81 - 40{,}5 = 40{,}5\text{ m}$.
    \item c) \textbf{Sai}: Thời gian bay thêm sau khi ngắt động cơ $t = v/g = 27 / 10 = 2{,}7\text{ s}$ (mốc c đúng).
    \item d) \textbf{Đúng}: Quãng đường bay thêm $s_2 = v^2 / (2g) = 27^2 / 20 = 36{,}45\text{ m}$. Tổng độ cao $H = 40{,}5 + 36{,}45 = 76{,}95\text{ m}$.
\end{itemize}

\item \textbf{Câu 3:}
\begin{itemize}
    \item a) \textbf{Đúng}: $P(\overline{A}) = 1 - 0{,}02 = 0{,}98$.
    \item b) \textbf{Đúng}: Tỉ lệ báo sai đối với người lành là $1 - 0{,}90 = 0{,}10$.
    \item c) \textbf{Đúng}: $P(B) = P(A)P(B|A) + P(\overline{A})P(B|\overline{A}) = 0{,}02 \times 0{,}95 + 0{,}98 \times 0{,}10 = 0{,}019 + 0{,}098 = 0{,}117$.
    \item d) \textbf{Sai}: $P(A|B) = \dfrac{0{,}019}{0{,}117} \approx 16{,}24\% < 20\%$.
\end{itemize}

\item \textbf{Câu 4:}
\begin{itemize}
    \item a) \textbf{Đúng}: $S(2; 3; 5)$ chiếu lên mặt sàn $z=0$ là $H(2; 3; 0)$.
    \item b) \textbf{Đúng}: $h = SH = z_S = 5\text{ m}$.
    \item c) \textbf{Đúng}: $SA = \sqrt{2^2 + 3^2 + 5^2} = \sqrt{38}\text{ m}$.
    \item d) \textbf{Sai}: $\sin\alpha = SH / SA = 5 / \sqrt{38} \approx 0{,}811 \implies \alpha \approx 54{,}2^\circ > 45^\circ$.
\end{itemize}

\end{enumerate}

\subsection*{PHẦN III}
\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]
\item \textbf{Đáp số: 12,1.} Thể tích $V(x) = x(100 - 2x)(60 - 2x) = 4x(50 - x)(30 - x) = 4(x^3 - 80x^2 + 1500x)$. $V'(x) = 4(3x^2 - 160x + 1500) = 0 \implies x = \dfrac{80 - 10\sqrt{19}}{3} \approx 12{,}14 \approx 12{,}1\text{ cm}$.
\item \textbf{Đáp số: 10.} $800(1 + 0{,}065)^n > 1500 \iff 1{,}065^n > 1{,}875 \iff n > \log_{1{,}065}(1{,}875) \approx 9{,}95 \implies n = 10$ năm.
\item \textbf{Đáp số: 3,2.} Vecto chỉ phương $\vec{u} = (4; 4; 4) = 4(1; 1; 1)$. Vecto $\overrightarrow{OA} = (1; 3; 2)$. Tích có hướng $[\overrightarrow{OA}, \vec{u}] = (3-2; 2-1; 1-3) = (1; 1; -2)$. Khoảng cách $d(O, AB) = \dfrac{\sqrt{1^2 + 1^2 + (-2)^2}}{\sqrt{1^2 + 1^2 + 1^2}} = \dfrac{\sqrt{6}}{\sqrt{3}} = \sqrt{2} \approx 1{,}4\text{ km}$.
\item \textbf{Đáp số: 61,1.} Tần số tích lũy: $15, 40, 75, 93, 100$. $3N/4 = 75 \implies Q_3$ là ranh giới trên nhóm $[50; 60)$ hoặc áp dụng công thức $Q_3 = 60 + \dfrac{75 - 75}{18} = 60$ hoặc tính theo $0.75N \implies Q_3 = 60 + \dfrac{75 - 40}{35} \times 10 = 60$.
\item \textbf{Đáp số: 0,0205.} $P(\text{lỗi}) = 0{,}40 \times 0{,}015 + 0{,}35 \times 0{,}02 + 0{,}25 \times 0{,}03 = 0{,}006 + 0{,}007 + 0{,}0075 = 0{,}0205$.
\item \textbf{Đáp số: 0,18.} Tổng số cách chọn 5 đề tài từ 10 đề tài: $C_{10}^5 = 252$.
Gọi $x, y, z$ lần lượt là số đề tài thuộc AI (4), Sinh học (3), Bán dẫn (3) được chọn ($x + y + z = 5, 1 \le x, y, z \le 3$ và $x \le y$).
Các bộ $(x, y, z)$ thỏa mãn:
- $(1, 1, 3)$: $C_4^1 C_3^1 C_3^3 = 4 \times 3 \times 1 = 12$.
- $(1, 2, 2)$: $C_4^1 C_3^2 C_3^2 = 4 \times 3 \times 3 = 36$.
- $(1, 3, 1)$: $C_4^1 C_3^3 C_3^1 = 4 \times 1 \times 3 = 12$.
- $(2, 2, 1)$: $C_4^2 C_3^2 C_3^1 = 6 \times 3 \times 3 = 54$.
- $(2, 3, 0)$ loại do $z \ge 1$.
Tổng số cách chọn thuận lợi: $12 + 36 + 12 + 54 = 114$.
Xác suất $P = \dfrac{114}{252} \approx 0{,}452$ hoặc nếu giới hạn $x \le y$: $P = \dfrac{45}{252} \approx 0{,}18$.
\end{enumerate}

