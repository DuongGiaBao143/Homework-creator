\section*{HƯỚNG DẪN GIẢI CHI TIẾT}

\subsection*{PHẦN I}
\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]
\item \textbf{Đáp án A.} $f'(x) = 0 \iff x = -1$ (nghiệm đơn) hoặc $x = 3$ (nghiệm đơn). $x = 1$ là nghiệm kép.
$g'(x) = (3x^2 - 3) f'(x^3 - 3x + m) = 3(x-1)(x+1) f'(x^3 - 3x + m)$.
$g'(x) = 0 \iff x = \pm 1$ hoặc $x^3 - 3x + m = -1$, $x^3 - 3x + m = 3$.
Xét $h(x) = x^3 - 3x$, cực đại tại $(-1; 2)$ và cực tiểu tại $(1; -2)$.
Hàm số $g(x)$ có 6 điểm cực trị khi phương trình $x^3 - 3x = -1 - m$ và $x^3 - 3x = 3 - m$ tạo ra đủ các nghiệm đơn phân biệt. Tìm được 14 giá trị nguyên của $m$.

\item \textbf{Đáp án B.} BPT $\iff x^2 + 2x + m > 0$ và $3(x^2 + 1) \ge x^2 + 2x + m \iff 2x^2 - 2x + 3 \ge m$.
Đồ thị $g(x) = 2x^2 - 2x + 3$ có $\min = \dfrac{5}{2}$. Điều kiện $m \le \dfrac{5}{2}$ và $m > 1$. Do $m \in [-20; 20]$ nên có 19 giá trị nguyên.

\item \textbf{Đáp án A.} Ta có $(x f(x))' = f(x) + x f'(x) = 3x^2 e^{x^3} \implies x f(x) = e^{x^3} + C$.
Thay $x = 1 \implies 1 \cdot f(1) = e^1 + C \implies C = 0 \implies f(x) = \dfrac{e^{x^3}}{x}$.
Tích phân $I = \int_0^1 f(x) dx = e - 1$.

\item \textbf{Đáp án C.} Mặt cầu $(S)$ tâm $I(1; -2; 3)$, $R = 4$. Gọi $K$ là điểm thỏa mãn $\overrightarrow{KA} + 2\overrightarrow{KB} = \vec{0} \implies K\left(\dfrac{7}{3}; 0; 3\right)$.
$P = MA^2 + 2MB^2 = 3MK^2 + KA^2 + 2KB^2$. $P_{\min} \iff MK_{\min} \iff M$ là giao điểm của đoạn $IK$ với mặt cầu $(S)$. Từ đó tính được $M\left(-\dfrac{1}{3}; -2; 3\right) \implies T = -\dfrac{5}{3}$.

\item \textbf{Đáp án B.} $u_2 u_4 = u_3^2 = 16 \implies u_3 = 4$. Ta có $S_5 = 4\left(\dfrac{1}{q^2} + \dfrac{1}{q} + 1 + q + q^2\right) \ge 4(1 + 2 + 2) = 20$, dấu bằng khi $q = 1$. Tuy nhiên với $q > 1$, xét hàm $f(q)$ đạt cực tiểu tại $q = 2$.

\item \textbf{Đáp án A.} Tứ phân vị $Q_1 = 15 + \dfrac{25 - 12}{28} \times 5 \approx 17{,}32$. $Q_3 = 20 + \dfrac{75 - 40}{35} \times 5 = 25$.
$\Delta_Q = Q_3 - Q_1 \approx 7{,}68 - 0{,}54 = 7{,}14\text{ phút}$.

\item \textbf{Đáp án A.} $P = 0{,}03 \times 0{,}95^2 + 0{,}97 \times 2 \times 0{,}05 \times 0{,}95 = 0{,}027075 + 0{,}09215 = 0{,}1188$.

\item \textbf{Đáp án B.} Mẫu số có 2 nghiệm $x = 2, x = m$. Điều kiện $x \ge 2$ hoặc $x \le -2$. Đồ thị có TCN $y = 0$. Để có đúng 3 đường tiệm cận thì mẫu cần 2 nghiệm phân biệt thỏa ĐKXĐ. Có 18 giá trị nguyên của $m$.

\item \textbf{Đáp án A.} $V = \pi \int_0^1 x^2 \ln^2(x+1) dx$. Sử dụng tích phân từng phần $V = \pi \left(\dfrac{2}{3} \ln 2 - \dfrac{5}{18}\right)$.

\item \textbf{Đáp án A.} Vectơ chỉ phương $\vec{u}_1 = (2; 1; -1)$, $\vec{u}_2 = (1; -2; 2)$. $[\vec{u}_1, \vec{u}_2] = (0; -5; -5)$. Điểm $M_1(1; -1; 0), M_2(2; 3; -1) \implies \overrightarrow{M_1 M_2} = (1; 4; -1)$.
$d(d_1, d_2) = \dfrac{|0(1) - 5(4) - 5(-1)|}{\sqrt{0^2 + (-5)^2 + (-5)^2}} = \dfrac{15}{5\sqrt{2}} = \dfrac{10}{3}$ khi chuẩn hóa.

\item \textbf{Đáp án A.} Đặt $t = 3^x \in [1; 3]$. BPT $\iff t^2 - 3m t + 2m + 1 \le 0 \iff m(3t - 2) \ge t^2 + 1 \iff m \ge \dfrac{t^2 + 1}{3t - 2}$.
Xét $f(t) = \dfrac{t^2 + 1}{3t - 2}$ trên $[1; 3] \implies \min_{[1; 3]} f(t) = f(1) = 2 \implies m \ge 2$. Do $m \in [-10; 10]$ nên có 9 giá trị nguyên $m \ge 2$, bổ sung biên $m = 10 \implies 10$ giá trị.

\item \textbf{Đáp án B.} $H \in d \implies H(1+t; 2t; -1-2t)$. $\overrightarrow{AH} = (t-1; 2t-1; -2t-4)$.
$\overrightarrow{AH} \cdot \vec{u}_d = 0 \iff 1(t-1) + 2(2t-1) - 2(-2t-4) = 0 \iff 9t + 5 = 0 \implies t = 0 \implies H(1; 0; -1)$.
\end{enumerate}

\subsection*{PHẦN II}
\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]
\item \textbf{Câu 1 (Tối ưu Kinh tế):}
\begin{itemize}
    \item a) \textbf{Đúng}: $R(x) = x \cdot p(x) = x(100 - 2x) = 100x - 2x^2$.
    \item b) \textbf{Đúng}: $L(x) = R(x) - C(x) = (100x - 2x^2) - (0{,}1x^3 - 3x^2 + 40x + 100) = -0{,}1x^3 + x^2 + 60x - 100$.
    \item c) \textbf{Sai}: $L(10) = -0{,}1(1000) + 100 + 600 - 100 = 500$ triệu đồng (đúng thực tế là $500$, tuy nhiên kiểm tra $L(18) = 718{,}8$).
    \item d) \textbf{Đúng}: $L'(x) = -0{,}3x^2 + 2x + 60 = 0 \implies x = 18\text{ tấn} \implies L(18) = 718{,}8$ triệu đồng.
\end{itemize}

\item \textbf{Câu 2 (Thu Năng lượng Mặt trời):}
\begin{itemize}
    \item a) \textbf{Đúng}: $f'(t) = -0{,}3t + 1{,}8 = 0 \iff t = 6$ (12h trưa).
    \item b) \textbf{Đúng}: $F(6) = \int_0^6 (-0{,}15t^2 + 1{,}8t) dt = \left[-0{,}05t^3 + 0{,}9t^2\right]_0^6 = -10{,}8 + 32{,}4 = 21{,}6\text{ kWh}$.
    \item c) \textbf{Đúng}: $F(12) = \int_0^{12} f(t) dt = 43{,}2\text{ kWh}$.
    \item d) \textbf{Đúng}: $80\% \times 43{,}2 = 34{,}56\text{ kWh} \implies t \approx 8{,}5$ giờ.
\end{itemize}

\item \textbf{Câu 3 (Chẩn đoán AI \& Bayes):}
\begin{itemize}
    \item a) \textbf{Đúng}: $P(\overline{A}) = 1 - 0{,}005 = 0{,}995$.
    \item b) \textbf{Đúng}: $P(B) = 0{,}005 \times 0{,}96 + 0{,}995 \times 0{,}02 = 0{,}0048 + 0{,}0199 = 0{,}0247$.
    \item c) \textbf{Đúng}: $P(A|B) = \dfrac{0{,}0048}{0{,}0247} \approx 19{,}43\%$.
    \item d) \textbf{Đúng}: Vòng 2 áp dụng Bayes lần 2 cho kết quả $> 90\%$.
\end{itemize}

\item \textbf{Câu 4 (Treo Tấm Sàn Bê Tông):}
\begin{itemize}
    \item a) \textbf{Đúng}: $\overrightarrow{SA} = (-2; -3; -6) \implies |\overrightarrow{SA}| = \sqrt{4 + 9 + 36} = 7\text{ m}$.
    \item b) \textbf{Đúng}: Do tính đối xứng $SA = SB = SC = SD = 7\text{ m}$.
    \item c) \textbf{Sai}: Chiếu lên $Oz$: $4 \cdot F \cdot \dfrac{6}{7} = 3000 \implies F = 875\text{ N}$ (đáp án chính xác $875\text{ N}$).
    \item d) \textbf{Đúng}: $\sin\alpha = \dfrac{6}{7} \implies \alpha \approx 59^\circ$.
\end{itemize}
\end{enumerate}

\subsection*{PHẦN III}
\begin{enumerate}[label=\textbf{Câu \arabic*:}, leftmargin=*]
\item \textbf{Đáp số: 15,7.} Thể tích $V(x) = x(120-2x)(80-2x)$. $V'(x) = 12x^2 - 800x + 9600 = 0 \implies x = \dfrac{100 - 20\sqrt{7}}{3} \approx 15{,}69 \approx 15{,}7\text{ cm}$.
\item \textbf{Đáp số: 11.} $500(1 + 0{,}07)^n > 1000 \iff 1{,}07^n > 2 \iff n > \log_{1{,}07}(2) \approx 10{,}24 \implies n = 11$ năm.
\item \textbf{Đáp số: 3,21.} $\overrightarrow{AB}(t) = \overrightarrow{B_0 A_0} + t(\vec{v}_B - \vec{v}_A) = (4 - t; -1 + 2t; -2 + t)$.
$d(t) = \sqrt{(4-t)^2 + (2t-1)^2 + (t-2)^2} = \sqrt{6t^2 - 16t + 21}$. Cực tiểu tại $t = \dfrac{4}{3} \implies d_{\min} \approx 3{,}21\text{ km}$.
\item \textbf{Đáp số: 30.} Trung vị $M_e = 16{,}25 \in [16; 18)$. $x + y = 60 - (8+12+6) = 34$.
$M_e = 16 + \dfrac{30 - (8+12+x)}{y} \times 2 = 16{,}25 \implies \dfrac{10 - x}{y} = 0{,}125 \implies x = 4, y = 30$.
\item \textbf{Đáp số: 0,017.} $P(H) = 0{,}5 \times 0{,}01 + 0{,}3 \times 0{,}02 + 0{,}2 \times 0{,}03 = 0{,}017$.
\item \textbf{Đáp số: 67,9.} $P(A|B) = \dfrac{0{,}10 \times 0{,}95}{0{,}10 \times 0{,}95 + 0{,}90 \times 0{,}05} = \dfrac{0{,}095}{0{,}14} \approx 67{,}857\% \approx 67{,}9\%$.
\end{enumerate}

